{
  "manifestVersion": 5,
  "id": "com.clipcutter.panel",
  "name": "ClipCutter",
  "version": "1.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "main",
      "label": { "default": "ClipCutter" },
      "minimumSize": { "width": 340, "height": 520 },
      "preferredSize": { "width": 400, "height": 760 }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": ["http://localhost:7742"]
    }
  }
}
