# Python virtual environment (~1 GB — recreated by ./install.sh)
helper/firstpass-env/
# pre-rename venv; kept ignored so an existing checkout doesn't try to commit it
helper/clipcutter-env/

# Python caches
__pycache__/
*.pyc
*.pyo
*.pyd

# Logs
*.log
*.log.1

# Diagnostics dumps written by Settings → Copy diagnostics
helper/firstpass_debug.json
helper/clipcutter_debug.json

# Crash-resume state
helper/firstpass_state.json

# Packaged plugin artifacts (attached to GitHub Releases, not committed)
*.ccx

# macOS
.DS_Store

# Editor / session artifacts
.artifacts/

# accidental brace-expansion dir
{plugin,helper}/
