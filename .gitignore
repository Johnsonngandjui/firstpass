# Python virtual environment (~1 GB — recreated by ./install.sh)
helper/firstpass-env/

# Python caches
__pycache__/
*.pyc
*.pyo
*.pyd

# Logs
*.log
*.log.1

# Diagnostics dumps written by Settings → Copy diagnostics
helper/firstpass_debug.json

# Crash-resume state
helper/firstpass_state.json

# Packaged plugin artifacts. The panel is loaded via UXP Developer Tool, so
# nothing here ships one — this just keeps a local build from being committed.
*.ccx

# macOS
.DS_Store

# Editor / session artifacts
.artifacts/

# accidental brace-expansion dir
{plugin,helper}/
